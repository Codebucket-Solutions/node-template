{
	"name": "node-template",
	"version": "1.0.0",
	"description": "",
	"main": "app.js",
	"scripts": {
		"plop": "plop",
		"start:16": "node --loader @codebucket/azure-env ./bin/www",
		"start": "node --import @codebucket/azure-env ./bin/www",
		"start:dev": "cross-env NODE_ENV=development nodemon ./bin/www",
		"migrate": "node scripts/run-migrations.js up",
		"migrate:down": "node scripts/run-migrations.js down",
		"migrate:status": "node scripts/run-migrations.js status",
		"migrate:pending": "node scripts/run-migrations.js pending",
		"migration:new": "node scripts/new-migration.js",
		"test": "cross-env NODE_ENV=test mocha \"test/**/*.test.js\" --exit",
		"test:dev": "cross-env NODE_ENV=development mocha \"test/**/*.test.js\" --exit",
		"test:smoke": "cross-env NODE_ENV=test node scripts/smoke-server.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
		"format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
		"prepare": "husky install",
		"architecture:inventory": "node scripts/generate-architecture-inventory.js",
		"docs:validate": "node scripts/validate-docs.js",
		"quality:score": "node scripts/score-quality.js",
		"claim:check": "node scripts/check-plan-claims.js",
		"dev:stack:up": "node scripts/dev-stack.js up",
		"dev:stack:down": "node scripts/dev-stack.js down",
		"dev:stack:logs": "node scripts/dev-stack.js logs",
		"dev:stack:config": "node scripts/dev-stack.js config",
		"obs:query": "node scripts/query-observability.js",
		"plan:new": "node scripts/new-plan.js",
		"worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
		"verify": "npm run lint && npm run format:check && npm run architecture:inventory && npm run docs:validate && npm run quality:score && npm run test && npm run test:smoke",
		"symphony:bootstrap": "bash scripts/symphony-bootstrap.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Codebucket-Solutions/node-template.git"
	},
	"author": "Codebucket Solutions Pvt. Ltd.",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Codebucket-Solutions/node-template/issues"
	},
	"homepage": "https://github.com/Codebucket-Solutions/node-template#readme",
	"dependencies": {
		"@codebucket/azure-env": "^1.0.2",
		"@codebucket/files": "^1.0.34",
		"@codebucket/logserver-transport": "^1.0.2",
		"@codebucket/mail-transport": "^1.0.5",
		"@codebucket/puppet-master": "^1.0.7",
		"@codebucket/sms": "^1.0.12",
		"@opentelemetry/auto-instrumentations-node": "^0.81.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
		"@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
		"@opentelemetry/sdk-node": "^0.223.0",
		"aws-sdk": "^2.1309.0",
		"bcryptjs": "^2.4.3",
		"body-parser": "^1.20.1",
		"camelcase-keys": "^7.0.2",
		"casbin": "^5.23.2",
		"casbin-sequelize-adapter": "^2.4.0",
		"clamscan": "^2.1.2",
		"cls-hooked": "^4.2.2",
		"cors": "^2.8.5",
		"cross-env": "^7.0.3",
		"dotenv": "^16.0.3",
		"express": "^4.18.2",
		"express-rate-limit": "^8.2.1",
		"helmet": "^6.0.1",
		"humps": "^2.0.1",
		"joi": "^17.7.0",
		"jsonwebtoken": "^9.0.0",
		"moment-timezone": "^0.5.40",
		"multer": "^2.1.1",
		"mysql2": "^3.1.0",
		"node-cron": "^4.2.1",
		"nodemailer": "^10.0.16",
		"pagi-help": "^2.5.0",
		"pino": "^8.20.0",
		"pino-http": "^9.0.0",
		"pino-loki": "^2.6.0",
		"pino-pretty": "^11.0.0",
		"rate-limit-redis": "^4.3.0",
		"redis": "^5.10.0",
		"sequelize": "^6.28.0",
		"umzug": "^3.8.2",
		"uuid": "^9.0.0"
	},
	"devDependencies": {
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-prettier": "^5.5.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"mocha": "^10.8.2",
		"nodemon": "^3.1.11",
		"plop": "^3.1.1",
		"prettier": "^3.5.3",
		"supertest": "^7.2.2"
	},
	"overrides": {
		"@codebucket/files": {
			"mime": "3.0.0"
		}
	},
	"lint-staged": {
		"*.js": [
			"eslint",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	}
}
