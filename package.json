{
	"name": "node-template",
	"version": "1.0.0",
	"description": "",
	"main": "app.js",
	"scripts": {
		"plop": "plop",
		"start:16": "node --loader @codebucket/azure-env ./bin/www",
		"start": "node --import @codebucket/azure-env ./bin/www",
		"start:dev": "cross-env NODE_ENV=development nodemon ./bin/www",
		"test:dev": "set NODE_ENV=development&&mocha test/*.js --exit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
		"format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
		"prepare": "husky install",
		"docs:validate": "node scripts/validate-docs.js",
		"quality:score": "node scripts/score-quality.js",
		"plan:new": "node scripts/new-plan.js",
		"worktree:bootstrap": "bash scripts/worktree-bootstrap.sh",
		"verify": "npm run lint && npm run format:check && npm run docs:validate && npm run quality:score",
		"symphony:bootstrap": "bash scripts/symphony-bootstrap.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Codebucket-Solutions/node-template.git"
	},
	"author": "Codebucket Solutions Pvt. Ltd.",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Codebucket-Solutions/node-template/issues"
	},
	"homepage": "https://github.com/Codebucket-Solutions/node-template#readme",
	"dependencies": {
		"@codebucket/files": "^1.0.0",
		"@codebucket/mail-transport": "^1.0.0",
		"@codebucket/sms": "^1.0.0",
		"@codebucket/azure-env": "^1.0.2",
		"@codebucket/logserver-transport": "^1.0.2",
		"aws-sdk": "^2.1309.0",
		"axios": "^1.3.2",
		"bcryptjs": "^2.4.3",
		"body-parser": "^1.20.1",
		"camelcase-keys": "^7.0.2",
		"casbin": "^5.23.2",
		"casbin-sequelize-adapter": "^2.4.0",
		"clamscan": "^2.1.2",
		"cls-hooked": "^4.2.2",
		"cors": "^2.8.5",
		"cross-env": "^7.0.3",
		"crypto": "^1.0.1",
		"dotenv": "^16.0.3",
		"express": "^4.18.2",
		"express-rate-limit": "^8.2.1",
		"formidable": "^2.1.1",
		"helmet": "^6.0.1",
		"humps": "^2.0.1",
		"joi": "^17.7.0",
		"jsonwebtoken": "^9.0.0",
		"moment-timezone": "^0.5.40",
		"mysql2": "^3.1.0",
		"nodemailer": "^7.0.10",
		"pino": "^8.20.0",
		"pino-http": "^9.0.0",
		"node-cron": "^4.2.1",
		"pino-pretty": "^11.0.0",
		"rate-limit-redis": "^4.3.0",
		"redis": "^5.10.0",
		"sequelize": "^6.28.0",
		"uuid": "^9.0.0"
	},
	"devDependencies": {
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-node": "^11.1.0",
		"eslint-plugin-prettier": "^5.5.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"nodemon": "^3.1.11",
		"plop": "^3.1.1",
		"prettier": "^3.5.3"
	},
	"overrides": {
		"@codebucket/files": {
			"mime": "3.0.0"
		}
	},
	"lint-staged": {
		"*.js": [
			"eslint",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	}
}
