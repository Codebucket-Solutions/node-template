# EditorConfig helps maintain consistent coding styles across different editors and IDEs
# For more information, visit: https://editorconfig.org

root = true

# Apply to all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript, JSON, and related files
[*.{js,json,yml,yaml}]
indent_style = tab
indent_size = 4
max_line_length = 100

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Package.json and similar files
[package.json]
indent_style = tab
indent_size = 2

# YAML files (often prefer spaces)
[*.{yml,yaml}]
indent_style = space
indent_size = 2
