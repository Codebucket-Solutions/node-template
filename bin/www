#!/usr/bin/env node

const { loadEnvironment } = require("../config/load-env");

loadEnvironment(process.env.NODE_ENV);

/**
 * Module dependencies.
 */
const cluster = require("cluster");
const cpu = require("os").cpus().length;
const debug = require("debug")("sidebrain:server");
const http = require("http");
const { startOpenTelemetry, shutdownOpenTelemetry } = require("../instrumentation/opentelemetry");
const port = normalizePort(process.env.PORT || "8080");
let server;
let app;
let shuttingDown = false;
const initMaster = require("../init");

/**
 * Get port from environment and store in Express.
 */

async function runMaster() {
	console.log("Starting master initialization");
	await initMaster();
	console.log("Master-only services initialized");

	const workers =
		process.env.WEB_CONCURRENCY ??
		(process.env.NODE_ENV === "stage" || process.env.NODE_ENV === "development"
			? 1
			: Math.max(1, cpu));

	for (let i = 0; i < Number(workers); i++) {
		console.log("Forking worker", i + 1, "of", Number(workers));
		cluster.fork();
	}
}

if (cluster.isPrimary) {
	runMaster().catch(err => {
		console.error("Master initialization failed:", err);
		process.exit(1);
	});

	cluster.on("exit", worker => {
		console.log(`Worker ${worker.process.pid} died, restarting`);
		cluster.fork();
	});
} else {
	bootstrapWorker().catch(async error => {
		console.error("Worker bootstrap failed:", error);
		await shutdownOpenTelemetry("worker-bootstrap-failure");
		process.exit(1);
	});
}

async function bootstrapWorker() {
	await startOpenTelemetry();
	registerTerminationHandlers();

	app = require("../app");
	app.set("port", port);

	/**
	 * Create HTTP server.
	 */
	server = http.createServer(app);

	/**
	 * Listen on provided port, on all network interfaces.
	 */
	server.listen(port, () => {
		console.log(`Worker ${process.pid} running`);
		console.log(`Port : ${port}`);
		console.log(`Env: ${process.env.NODE_ENV}`);
	});
	server.keepAliveTimeout = 30000;

	server.on("error", onError);
	server.on("listening", onListening);
}

function registerTerminationHandlers() {
	for (const signal of ["SIGINT", "SIGTERM"]) {
		process.on(signal, () => {
			void gracefulShutdown(signal);
		});
	}
}

async function gracefulShutdown(signal) {
	if (shuttingDown) {
		return;
	}

	shuttingDown = true;
	console.log(`Received ${signal}, shutting down worker ${process.pid}`);

	const closeServer = new Promise(resolve => {
		if (!server) {
			resolve();
			return;
		}

		server.close(() => {
			resolve();
		});
	});

	await closeServer;
	await shutdownOpenTelemetry(signal);
	process.exit(0);
}

/**
 * Normalize a port into a number, string, or false.
 */
function normalizePort(val) {
	const port = parseInt(val, 10);

	if (isNaN(port)) {
		// named pipe
		return val;
	}

	if (port >= 0) {
		// port number
		return port;
	}

	return false;
}

/**
 * Event listener for HTTP server "error" event.
 */
function onError(error) {
	if (error.syscall !== "listen") {
		throw error;
	}

	const bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

	// handle specific listen errors with friendly messages
	switch (error.code) {
		case "EACCES":
			console.error(bind + " requires elevated privileges");
			process.exit(1);
			break;
		case "EADDRINUSE":
			console.error(bind + " is already in use");
			process.exit(1);
			break;
		default:
			throw error;
	}
}

/**
 * Event listener for HTTP server "listening" event.
 */
function onListening() {
	const addr = server.address();
	const bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
	debug("Listening on " + bind);
}
